# ─── Core ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://multicast:multicast@localhost:5432/multicast"
REDIS_URL="redis://localhost:6379"
APP_URL="http://localhost:3000"   # on Vercel: leave unset (uses the production URL) or set your custom domain

# 32 random bytes, base64. Generate with: npm run gen:key
# Master key for AES-256-GCM encryption of API keys and OAuth tokens. Never change it
# after secrets are stored, or they become unreadable.
ENCRYPTION_KEY=""

# NextAuth session signing secret (any long random string)
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# ─── File storage (S3-compatible; must be publicly readable over HTTPS for Instagram) ───
# Leave S3_BUCKET empty to store files on local disk under ./storage (served at /api/files/...);
# fine for development, but Instagram publishing needs a public HTTPS URL.
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""                # e.g. http://localhost:9000 for MinIO, or your R2/S3 endpoint
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""         # public URL prefix for objects, e.g. https://cdn.example.com
S3_FORCE_PATH_STYLE="true"

# Vercel Blob (alternative to S3; used when S3_BUCKET is empty). Added automatically when you
# connect a Blob store to the Vercel project.
BLOB_READ_WRITE_TOKEN=""

# ─── Email reminders (Resend or SMTP; Resend wins if both set) ───────────
EMAIL_FROM="Multicast <multicast@example.com>"
EMAIL_TO=""                   # defaults to the owner's login email
EMAIL_RESEND_API_KEY=""
EMAIL_SMTP_HOST=""
EMAIL_SMTP_PORT="587"
EMAIL_SMTP_USER=""
EMAIL_SMTP_PASS=""

# ─── Browser push (optional). Generate with: npx web-push generate-vapid-keys ───
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

# ─── Publishing OAuth apps (all optional; each platform works in copy mode without) ───
META_APP_ID=""
META_APP_SECRET=""
META_GRAPH_VERSION="v23.0"

LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
LINKEDIN_API_VERSION="202509"   # LinkedIn-Version header, YYYYMM
LINKEDIN_COMPANY_ENABLED="false" # set true once Community Management API access is approved

REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""
REDDIT_USER_AGENT="web:multicast:v0.1 (by /u/your_username)"

# ─── Optional creative tools (Canva uses OAuth; client ID/secret are entered in the UI) ───
